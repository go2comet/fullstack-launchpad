# Supabase — find these in: https://supabase.com/dashboard/project/<ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only — NEVER expose client-side (used only in src/lib/supabase/admin.ts)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# App base URL (used for OAuth redirects)
# local:   http://localhost:3000
# preview: https://<your-vercel-preview-url>
# prod:    https://<your-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
